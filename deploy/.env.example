# ============================================================================
# autolycus-agent.ru — Deploy Configuration
# ============================================================================
#
# Copy to .env and fill in values before running docker compose.

# Agent
AUTOLYCUS_LOG_LEVEL=info
OPENROUTER_API_KEY=
TELEGRAM_BOT_TOKEN=
SESSION_DB_PATH=/home/autolycus/.autolycus/state.db

# Gateway
GATEWAY_PORT=8500
GATEWAY_HOST=0.0.0.0

# Xray (optional, profile=full)
XRAY_EMAIL=admin@autolycus-agent.ru
